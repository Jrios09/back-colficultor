MONGODB_URI=mongodb://localhost:27017
DB_NAME=colficultor

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://127.0.0.1:5500"]

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=Colficultor <no-reply@colficultor.com>

FRONTEND_URL=http://localhost:5500/
BASE_URL_BACKEND=http://localhost:8000/

FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RESET_VALIDATE_RATE_LIMIT=10
AUTH_RESET_VALIDATE_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RESET_PASSWORD_RATE_LIMIT=5
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_FORGOT_PASSWORD_RATE_LIMIT=5
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=300

RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_ENABLED=true
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_SCORE_THRESHOLD=0.5

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
PRODUCT_IMAGE_MAX_SIZE_BYTES=5242880
PRODUCT_IMAGE_MAX_FILES_PER_PRODUCT=8

PAYMENT_PROVIDER=payu
APP_ENV=development
WEBHOOK_SECRET=your_webhook_secret
PAYMENT_SECRET=your_payment_secret
PAYMENT_PUBLIC_KEY=your_payment_public_key

PAYU_MERCHANT_ID=your_payu_merchant_id
PAYU_API_LOGIN=your_payu_api_login
PAYU_API_KEY=your_payu_api_key
PAYU_ACCOUNT_ID=your_payu_account_id
PAYU_COUNTRY=CO
PAYU_CURRENCY=COP
PAYU_SANDBOX=true
PAYU_SIGNATURE_ALGORITHM=MD5
